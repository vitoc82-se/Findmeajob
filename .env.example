# Neon Postgres connection string (Vercel + .env.local).
# Create a free DB at https://neon.tech, copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Claude API key (reuse your existing sk-ant-... key from GrantFinder/SnapMeal).
ANTHROPIC_API_KEY="sk-ant-..."
