# Neon Postgres connection string (set in Vercel project env vars).
# Create a free DB at https://neon.tech. Use the DIRECT / unpooled string
# (host WITHOUT "-pooler") — the build runs `prisma db push` to create tables,
# and DDL needs a direct connection. Phase 1 traffic is tiny, so direct is fine
# at runtime too. Switch to the pooled string later if concurrency grows.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Claude API key (reuse your existing sk-ant-... key from GrantFinder/SnapMeal).
ANTHROPIC_API_KEY="sk-ant-..."

# Voyage AI embeddings (semantic job matching). Free tier (~200M tokens) covers
# this app many times over. Key from https://dash.voyageai.com (starts "pa-...").
# Used to rank candidates by meaning and for cross-run pgvector recall. If unset,
# search still works — it falls back to source-order ranking.
VOYAGE_API_KEY="pa-..."

# Daily digest email (Resend — free tier). Get a key at https://resend.com
# RESEND_API_KEY="re_..."
# Sender. Use onboarding@resend.dev for quick testing, or verify findmeajob.online
# in Resend and use your own address.
# DIGEST_FROM="Findmeajob <noreply@findmeajob.online>"
# Secret for the cron endpoint + unsubscribe links. Any long random string.
# Vercel Cron sends it automatically as a Bearer token.
# CRON_SECRET="a-long-random-string"
# Public base URL used in emails (links + unsubscribe). Defaults to findmeajob.online.
# APP_URL="https://findmeajob.online"

# Admin dashboard (/admin) — comma-separated emails allowed to view usage stats.
# Use the email(s) you sign into Findmeajob with. Unset = nobody can view it.
# ADMIN_EMAILS="you@example.com"

# Facebook (Meta) Pixel for ad attribution. Consent-gated (loads only after the
# visitor accepts cookies). Unset = no pixel and no consent banner. Public value.
# NEXT_PUBLIC_FB_PIXEL_ID="1727597965197139"

# Adzuna (OPTIONAL) — broadens beyond Platsbanken. Free key: https://developer.adzuna.com
# The Adzuna source stays dormant until BOTH of these are set.
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""
# ADZUNA_COUNTRY="se"   # default "se"; e.g. "gb", "de" for other markets

