# Neon Postgres connection string (set in Vercel project env vars).
# Create a free DB at https://neon.tech. Use the DIRECT / unpooled string
# (host WITHOUT "-pooler") — the build runs `prisma db push` to create tables,
# and DDL needs a direct connection. Phase 1 traffic is tiny, so direct is fine
# at runtime too. Switch to the pooled string later if concurrency grows.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Claude API key (reuse your existing sk-ant-... key from GrantFinder/SnapMeal).
ANTHROPIC_API_KEY="sk-ant-..."

# Adzuna (OPTIONAL) — broadens beyond Platsbanken. Free key: https://developer.adzuna.com
# The Adzuna source stays dormant until BOTH of these are set.
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""
# ADZUNA_COUNTRY="se"   # default "se"; e.g. "gb", "de" for other markets

